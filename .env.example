# Enable client-side API mocking so the app runs without the real backend.
# Accepted values: true | false
# Default when unset: false — all requests go to the hardcoded backend URL
# configured in src/main.ts (http://sky-web.site:3031/api).
# Changing this value requires restarting the dev server (no code changes needed).
VITE_MOCK_API=false

# When VITE_MOCK_API=true, log in with the fixed mock credentials:
#   login: admin
#   password: admin
# Any other credentials produce a 401 login error.
